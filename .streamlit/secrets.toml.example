# .streamlit/secrets.toml — LOCAL ONLY, never commit this file
# Copy this template and fill in your credentials for local Streamlit use.
# On Streamlit Cloud, set these in the dashboard under App Settings → Secrets.

IBM_CLOUD_API_KEY = "your_ibm_cloud_api_key_here"
WATSONX_PROJECT_ID = "your_watsonx_project_id_here"
WATSONX_URL = "https://us-south.ml.cloud.ibm.com"
GRANITE_MODEL_ID = "ibm/granite-4-h-small"
GRANITE_EMBEDDING_MODEL_ID = "ibm/granite-embedding-278m-multilingual"
