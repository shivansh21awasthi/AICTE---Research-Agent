# ============================================================
#  IBM Cloud & Granite Configuration — Research Agent
#  Copy this file to .env and fill in your credentials.
#  Never commit .env to version control.
# ============================================================

# ── IBM watsonx.ai (Granite LLM) ────────────────────────────
# Obtain from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=

# watsonx.ai service URL (choose your region)
# us-south : https://us-south.ml.cloud.ibm.com
# eu-de    : https://eu-de.ml.cloud.ibm.com
# jp-tok   : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Your watsonx.ai project ID (found on the Manage tab of your project)
WATSONX_PROJECT_ID=7174169c-e047-4848-ab24-296c8a0754b2

# ── IBM Granite Model Selection ──────────────────────────────
# Summarization / generation model
GRANITE_MODEL_ID=ibm/granite-4-h-small

# Embedding model (for semantic search / vector similarity)
GRANITE_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# ── IBM Watson Discovery (optional — literature search) ──────
# Leave blank to use the built-in arXiv / Semantic Scholar search
DISCOVERY_API_KEY=
DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
DISCOVERY_PROJECT_ID=

# ── Agent Behaviour ──────────────────────────────────────────
# Maximum number of papers to retrieve per query
MAX_SEARCH_RESULTS=10

# Maximum tokens for LLM generation responses
MAX_NEW_TOKENS=800

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.3

# Top-P nucleus sampling
TOP_P=0.9

# ── Output Paths ─────────────────────────────────────────────
# Directory where generated reports and reference files are saved
OUTPUT_DIR=./output

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
